rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin(){ return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Perfil de cada persona. Su ID sale del nombre + PIN, así que solo
    // se puede abrir sabiendo los dos. No se puede listar.
    match /perfiles/{key} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && (!exists(/databases/$(database)/documents/ranking/$(request.resource.data.pid))
            || get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pid == request.resource.data.pid
            || isAdmin());
      allow update: if request.auth != null
        && request.resource.data.pid == resource.data.pid;
      allow list, delete: if false;
    }
    // Nombres ya registrados (para que nadie use el nombre de otro).
    match /nombres/{n} {
      allow get, create: if request.auth != null;
      allow list, update, delete: if false;
    }
    // Cada dispositivo apunta al perfil con el que ha entrado.
    match /devices/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/perfiles/$(request.resource.data.key)).data.pid == request.resource.data.pid;
    }
    // Ranking: lo lee cualquiera; cada uno escribe solo su fila.
    // Dispositivos suscritos a los avisos (solo los lee el servidor de avisos).
    match /tokens/{t} {
      allow create, update: if request.auth != null;
      allow read, delete: if false;
    }
    // Administración: un dispositivo pasa a ser administrador escribiendo el código correcto.
    // El código real NO está en GitHub: se pone solo en la consola de Firebase.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.code == 'CODIGO_ADMIN';
      allow list, update, delete: if false;
    }
    // Copia del progreso de cada participante, para poder restablecer su PIN.
    match /copias/{pid} {
      allow read: if isAdmin();
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pid == pid;
    }
    // Chulitos (sabotajes): cada uno lanza en su nombre; lo leen la víctima y quien lo lanzó.
    function miPid(){ return get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pid; }
    match /sabotajes/{id} {
      allow create: if request.auth != null
        && request.resource.data.from == miPid()
        && request.resource.data.to is string
        && request.resource.data.to != request.resource.data.from
        && request.resource.data.usado == false
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 30
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 30
        && getAfter(/databases/$(database)/documents/chulimite/$(request.resource.data.to + '_' + request.resource.data.dia)).data.n <= 2;
      allow read: if request.auth != null
        && (resource.data.to == miPid() || resource.data.from == miPid());
      allow update: if request.auth != null && (
        (resource.data.to == miPid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado','q','t2','res']))
        || (resource.data.from == miPid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])));
      allow delete: if false;
    }
    // Máximo 2 chulitos recibidos por persona y día.
    match /chulimite/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.n == 1;
      allow update: if request.auth != null && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 2;
      allow delete: if false;
    }
    // Porcentajes de respuesta: un voto por persona y pregunta.
    function votoNuevo(q){ return !exists(/databases/$(database)/documents/votos/$(q)/quien/$(miPid()))
        && existsAfter(/databases/$(database)/documents/votos/$(q)/quien/$(miPid())); }
    function suma(m){ return m.get('o0',0) + m.get('o1',0) + m.get('o2',0) + m.get('o3',0); }
    match /votos/{q} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && votoNuevo(q)
        && request.resource.data.keys().hasOnly(['o0','o1','o2','o3'])
        && request.resource.data.size() == 1 && suma(request.resource.data) == 1;
      allow update: if request.auth != null && votoNuevo(q)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['o0','o1','o2','o3'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && suma(request.resource.data) == suma(resource.data) + 1;
      allow delete: if false;
      match /quien/{pid} {
        allow create: if request.auth != null && pid == miPid() && request.resource.data.size() == 0;
        allow read, update, delete: if false;
      }
    }
    match /ranking/{pid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pid == pid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 30;
      allow delete: if request.auth != null && (request.auth.uid == pid
        || get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pid == pid);
    }
  }
}
